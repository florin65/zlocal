          MODULE=vim-nerdtree
         VERSION=7.1.1
          SOURCE=$MODULE-$VERSION.tar.gz
SOURCE_DIRECTORY=$BUILD_DIRECTORY/nerdtree-$VERSION
 SOURCE_URL_FULL=https://github.com/scrooloose/nerdtree/archive/$VERSION.tar.gz
      SOURCE_VFY=sha256:921b7741b45772104f854517c55ebc8eb0a601a6558339c4ca4d72b808e366a0
        WEB_SITE=http://github.com/scrooloose/nerdtree/
         ENTERED=20170430
         UPDATED=20240220
           SHORT="A tree explorer plugin for vim"

cat << EOF
The NERD tree allows you to explore your filesystem and to open files and
directories. It presents the filesystem to you in the form of a tree which
you manipulate with the keyboard and/or mouse. It also allows you to perform
simple filesystem operations.
EOF
