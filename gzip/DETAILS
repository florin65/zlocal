   SOURCE_URL[1]=http://www.funet.fi/pub/gnu/alpha/gnu/$MODULE
      SOURCE_VFY=sha256:9aa0cc780dec156b8282844833b342ab7cb08c25d2cd9a1869cdd0df31deff48
        WEB_SITE=https://www.gzip.org
