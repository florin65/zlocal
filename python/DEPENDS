depends bzip2
depends %OSSL
depends libffi
depends expat
depends pkgconf
depends zlib

optional_depends db   "" "" "for db support"

optional_depends gdbm \
                 "--with-dbmliborder=gdbm:ndbm" \
                 "" "for gdbm support"

optional_depends sqlite \
                 "--enable-loadable-sqlite-extensions" \
                 "" "for sqlite support"

optional_depends mpdecimal \
                 "--with-system-libmpdec" \
                 "" \
                 "use system mpdecimal instead of mpdecimal bundled with python" \
                 "n"
