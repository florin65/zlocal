depends ncurses
depends gawk
depends pcre
depends libgcrypt
depends zlib
depends acl

optional_depends gpm "--enable-gpm" "--disable-gpm" "for GPM mouse support"

optional_depends gtk \
                 "--enable-gui=gtk4 --with-x=yes" "--disable-gui" \
                 "for GTK 4.x Graphical User Interface support"

optional_depends libcanberra \
                 "--enable-canberra" \
                 "--disable-canberra" \
                 "for XDG-compatible sound generation"

optional_depends libsodium "--enable-libsodium"             "--disable-libsodium"     "for libsodium support"
optional_depends python    "--enable-python3interp=dynamic" "--disable-python3interp" "for Python interpreter support"
optional_depends perl      "--enable-perlinterp=dynamic"    "--disable-perlinterp"    "for Perl interpreter support"
optional_depends ruby      "--enable-rubyinterp=dynamic"    "--disable-rubyinterp"    "for Ruby interpreter support"
optional_depends lua       "--enable-luainterp=dynamic"     "--disable-luainterp"     "for Lua interpreter support" "n"
optional_depends tcl       "--enable-tclinterp=dynamic"     "--disable-tclinterp"     "for Tcl interpreter support" "n"
